PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/embellish_erp

# Set true to run against a MongoDB bundled into the server process, for when
# there is no MongoDB installed locally. Data lives in server/.mongo-data and
# only one process can hold it at a time — so seed first, then start the server.
# Refused in production.
USE_MEMORY_DB=false

# Session token. Must be replaced with a real secret in production; the server
# refuses to start on the default value when NODE_ENV=production.
JWT_SECRET=your_super_secret_jwt_key_embellish_erp_2026
JWT_EXPIRES_IN=7d

# Optional. Without these, site photos and drawings stay on local disk under
# server/uploads and are served from /uploads.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=embellish-uploads

# Origin allowed by CORS. The Vite dev server proxies /api, so in development
# the browser talks to the client's own origin and this is not exercised.
CLIENT_URL=http://localhost:5173
